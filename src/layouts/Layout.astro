---
// src/layouts/Layout.astro
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title = "Tiny Oracle — Instant 3-Card Tarot Reading & Cosmic Guidance",
  description = "Unveil your destiny instantly with Tiny Oracle. Draw 3 sacred tarot cards for Past, Present, and Future. $5 mystic reading powered by authentic oracle wisdom.",
  image = "/og-image.png",
  canonicalURL = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NLWJ5B43GV"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-NLWJ5B43GV");
    </script>
    <!-- Essential Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#120a2a" />
    <meta name="robots" content="index, follow" />
    <meta
      name="google-site-verification"
      content="q7zk66yqMbYi7gpKBIklF9uf6dfdAWgSt7NICNk-KZ0"
    />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="tarot reading, online tarot, 3 card spread, instant tarot reading, past present future tarot, daily oracle, mystic reading, tarot guidance"
    />
    <meta name="author" content="stupopa x sorelabs" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter Cards -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- Structured Data (JSON-LD) for Search Engines -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "Tiny Oracle",
        url: canonicalURL,
        description: description,
        applicationCategory: "LifestyleApplication",
        operatingSystem: "All",
        offers: {
          "@type": "Offer",
          price: "5.00",
          priceCurrency: "USD",
        },
      })}
    />

    <!-- Google Fonts for Whimsical / Storybook Vibe -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Quicksand:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body
    class="bg-[#120a2a] text-purple-100 font-sans min-h-screen flex flex-col justify-between selection:bg-pink-400 selection:text-slate-950 overflow-x-hidden relative"
  >
    <!-- Whimsical Cosmic Background Glows -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <div
        class="absolute top-10 left-1/4 w-96 h-96 bg-purple-600/20 rounded-full blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-20 right-1/4 w-80 h-80 bg-pink-500/15 rounded-full blur-[100px]"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-900/20 rounded-full blur-[150px]"
      >
      </div>
    </div>

    <!-- Header Section -->
    <header
      class="relative z-10 w-full max-w-5xl mx-auto px-6 py-6 flex justify-between items-center border-b border-purple-500/10"
    >
      <a href="/" class="flex items-center space-x-2 group">
        <span class="text-2xl animate-bounce">✨</span>
        <span
          class="font-serif font-extrabold text-xl md:text-2xl tracking-wider bg-gradient-to-r from-pink-200 via-purple-300 to-amber-200 bg-clip-text text-transparent group-hover:brightness-125 transition"
        >
          TINY ORACLE
        </span>
      </a>
      <span
        class="text-[11px] font-mono font-bold uppercase tracking-widest text-amber-200/90 bg-purple-900/40 px-3.5 py-1.5 rounded-full border border-pink-300/30 shadow-[0_0_15px_rgba(244,114,182,0.15)]"
      >
        ⭐ $5 Mystic Draw
      </span>
    </header>

    <!-- Main Content -->
    <main
      class="relative z-10 flex-grow flex flex-col items-center justify-center p-4 md:p-8"
    >
      <slot />
    </main>

    <!-- Footer Section -->
    <footer
      class="relative z-10 w-full border-t border-purple-900/40 py-8 text-center text-xs space-y-2"
    >
      <div
        class="flex items-center justify-center space-x-2 text-purple-300/80 font-medium"
      >
        <span>crafted with magic</span>
        <span class="text-pink-400">✦</span>
        <p
          class="tracking-wide font-bold bg-gradient-to-r from-pink-300 via-purple-200 to-amber-200 bg-clip-text text-transparent"
        >
          by stupopa x sorelabs
        </p>
      </div>
      <p class="text-[10px] text-purple-400/40">
        © {new Date().getFullYear()} Tiny Oracle. All rights reserved.
      </p>
    </footer>
  </body>
</html>

<style is:global>
  body {
    font-family: "Quicksand", sans-serif;
  }
  h1,
  h2,
  h3,
  .font-serif {
    font-family: "Cinzel Decorative", serif;
  }
</style>
