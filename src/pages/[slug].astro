---
// src/pages/[slug].astro
import Layout from "../layouts/Layout.astro";
import tarotData from "../assets/tarot-images.json";

// Helper slugify
const slugify = (text: string) =>
  text
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)+/g, "");

// 1. TANGKAP SLUG URL SECARA DINAMIS (SSR / ON-DEMAND)
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

// Map semua kartu berdasarkan slug name
const cards = tarotData.cards;
const cardMap = new Map(cards.map((c: any) => [slugify(c.name), c]));

// Split slug URL (misal: "the-fool-three-of-swords-the-star")
const slugParts = slug.split("-");

let pastCard: any = null;
let presentCard: any = null;
let futureCard: any = null;

// Algoritma pencocokan nama kartu dari slug URL
for (let i = 1; i < slugParts.length - 1; i++) {
  for (let j = i + 1; j < slugParts.length; j++) {
    const p1 = slugParts.slice(0, i).join("-");
    const p2 = slugParts.slice(i, j).join("-");
    const p3 = slugParts.slice(j).join("-");

    if (cardMap.has(p1) && cardMap.has(p2) && cardMap.has(p3)) {
      pastCard = cardMap.get(p1);
      presentCard = cardMap.get(p2);
      futureCard = cardMap.get(p3);
      break;
    }
  }
  if (pastCard) break;
}

// Jika slug gak valid / kartu gak ketemu, redirect 404
if (!pastCard || !presentCard || !futureCard) {
  return Astro.redirect("/404");
}

// Meta Title & Description Unik buat Google Indexing
const pageTitle = `${pastCard.name}, ${presentCard.name}, & ${futureCard.name} — Tarot Reading Meaning`;
const pageDescription = `Detailed 3-card tarot reading: Past (${pastCard.name}), Present (${presentCard.name}), and Future (${futureCard.name}). Unfold your spiritual guidance.`;

const selectedCards = [
  {
    role: "The Past",
    chapter: "CHAPTER I",
    storyContext: "Echoes of your footsteps and foundational energies that shaped your journey to this moment.",
    card: pastCard,
    name_short: pastCard.img.replace(/\.(jpg|png|webp)$/, ""),
    meaning: pastCard.meanings.light.join(". "),
    reverseLayout: false
  },
  {
    role: "The Present",
    chapter: "CHAPTER II",
    storyContext: "A mirror to your current reality. The active forces unfolding around your mind and soul.",
    card: presentCard,
    name_short: presentCard.img.replace(/\.(jpg|png|webp)$/, ""),
    meaning: presentCard.meanings.light.join(". "),
    reverseLayout: true
  },
  {
    role: "The Future",
    chapter: "CHAPTER III",
    storyContext: "Whispers of fate and potential events gently weaving into your upcoming timeline.",
    card: futureCard,
    name_short: futureCard.img.replace(/\.(jpg|png|webp)$/, ""),
    meaning: futureCard.meanings.light.join(". "),
    reverseLayout: false
  }
];

// Structured Data (JSON-LD)
const schemaData = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": pageTitle,
  "description": pageDescription,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": selectedCards.map((item, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": `${item.role}: ${item.card.name}`,
      "description": item.meaning
    }))
  }
};
---

<Layout title={pageTitle}>
  <!-- Inject Schema Markup JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"
  ></script>

  <div class="w-full max-w-4xl mx-auto space-y-16 py-8 px-4">
    <!-- Hero Header -->
    <div class="text-center space-y-4 max-w-xl mx-auto">
      <span
        class="inline-block px-4 py-1.5 rounded-full bg-purple-900/50 border border-pink-300/30 text-pink-300 text-xs font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(244,114,182,0.2)]"
      >
        ✦ Sacred 3-Card Reading ✦
      </span>
      <h1
        class="text-2xl md:text-4xl font-black font-serif text-transparent bg-gradient-to-r from-amber-100 via-pink-200 to-amber-300 bg-clip-text leading-tight"
      >
        {pastCard.name} • {presentCard.name} • {futureCard.name}
      </h1>
      <p class="text-purple-200/70 text-xs md:text-sm font-medium leading-relaxed">
        Unfold the chapters of your destiny. Click each card to reveal the hidden wisdom within.
      </p>
    </div>

    <!-- Container Kartu Dinamis -->
    <div class="space-y-16 min-h-[400px]">
      {selectedCards.map((item) => {
        const imagePath = `/cards/${item.name_short}.webp`;
        return (
          <section class="w-full bg-purple-950/30 border border-purple-500/20 rounded-3xl p-6 md:p-10 backdrop-blur-md shadow-[0_0_40px_rgba(18,10,42,0.8)] relative overflow-hidden group">
            
            <div class="flex items-center justify-between border-b border-purple-500/20 pb-4 mb-6">
              <div class="space-y-0.5">
                <span class="text-[10px] font-mono font-bold tracking-widest text-amber-300/80 uppercase block">{item.chapter}</span>
                <h2 class="text-lg md:text-xl font-serif font-bold text-pink-200">{item.role}</h2>
              </div>
              <span class="text-[11px] font-mono font-bold text-amber-200 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-300/30">
                🡅 UPRIGHT
              </span>
            </div>

            <div class={`flex flex-col ${item.reverseLayout ? "md:flex-row-reverse" : "md:flex-row"} items-center md:items-start gap-8 md:gap-12`}>
              
              <!-- Card Wrapper -->
              <div class="card-wrapper perspective-1000 w-52 h-84 md:w-60 md:h-96 flex-shrink-0 cursor-pointer" onclick="flipTarotCard(this)">
                <div class="card-inner relative w-full h-full transition-transform duration-700 transform-style-3d shadow-2xl rounded-2xl">
                  
                  <!-- Card Back -->
                  <div class="absolute inset-0 w-full h-full bg-[#0d0722] border-2 border-amber-300/40 rounded-2xl shadow-[0_0_20px_rgba(244,114,182,0.15)] flex flex-col items-center justify-center backface-hidden hover:border-pink-300 hover:shadow-[0_0_30px_rgba(244,114,182,0.3)] transition-all">
                    <div class="w-[90%] h-[93%] border border-purple-400/20 rounded-xl flex items-center justify-center bg-gradient-to-b from-purple-900/30 to-purple-950/80">
                      <div class="text-center space-y-2">
                        <span class="text-4xl block animate-pulse">✦</span>
                        <span class="text-amber-200 font-serif text-xl tracking-widest block font-bold">ORACLE</span>
                        <p class="text-[10px] text-pink-300/70 tracking-widest uppercase">Click to Reveal</p>
                      </div>
                    </div>
                  </div>

                  <!-- Card Front (WebP Image) -->
                  <div class="absolute inset-0 w-full h-full bg-slate-950 border-2 border-amber-300 rounded-2xl shadow-[0_0_35px_rgba(251,191,36,0.3)] rotate-y-180 backface-hidden p-2 flex flex-col items-center justify-center">
                    <div class="w-full h-full overflow-hidden rounded-xl bg-purple-950 flex items-center justify-center">
                      <img src={imagePath} alt={item.card.name} class="w-full h-full object-contain p-1 rounded-lg drop-shadow-md" onerror="this.src='/cards/card-back.jpg'" />
                    </div>
                  </div>

                </div>
              </div>

              <!-- Reading Text -->
              <div class="card-reading-text flex-grow space-y-4 text-left opacity-0 pointer-events-none scale-95 transition-all duration-700 ease-out">
                <div>
                  <span class="text-xs font-serif text-purple-300/60 italic block mb-1">"{item.storyContext}"</span>
                  <h3 class="text-2xl md:text-3xl font-serif font-black bg-gradient-to-r from-amber-100 via-pink-200 to-amber-200 bg-clip-text text-transparent">{item.card.name}</h3>
                </div>

                <div class="bg-[#090417]/80 border border-purple-500/20 p-5 rounded-2xl space-y-2 shadow-inner">
                  <span class="text-xs font-bold uppercase tracking-wider text-amber-300/90 flex items-center gap-1.5">
                    <span>✨</span> Interpretation & Guidance:
                  </span>
                  <p class="text-sm md:text-base leading-relaxed text-purple-100/90 font-medium">{item.meaning}</p>
                </div>
              </div>

            </div>
          </section>
        );
      })}
    </div>

    <!-- Call To Action Bottom / Lead Capture -->
    <div class="pt-12 text-center space-y-4 border-t border-purple-500/20">
      <a
        href="/"
        class="inline-block px-10 py-4 rounded-2xl bg-gradient-to-r from-amber-300 via-pink-300 to-amber-400 text-slate-950 font-serif font-black text-sm hover:scale-105 active:scale-95 transition shadow-[0_0_30px_rgba(251,191,36,0.4)] cursor-pointer"
      >
        DRAW ANOTHER SPREAD ($5)
      </a>
      <p class="text-[11px] text-purple-300/50">
        Destiny is ever-shifting. Every new draw channels fresh cosmic energy.
      </p>
    </div>
  </div>

  <!-- Handler Flip Client-side -->
  <script is:inline>
    window.flipTarotCard = function (element) {
      const inner = element.querySelector(".card-inner");
      const section = element.closest("section");
      const readingText = section
        ? section.querySelector(".card-reading-text")
        : null;

      if (inner && !inner.classList.contains("is-flipped")) {
        inner.classList.add("is-flipped");
        if (readingText) readingText.classList.add("reveal-text");
        if (typeof confetti === "function") {
          confetti({
            particleCount: 45,
            spread: 70,
            origin: { y: 0.6 },
            colors: ["#fef3c7", "#f472b6", "#c084fc"],
          });
        }
      }
    };
  </script>

  <style is:global>
    .perspective-1000 {
      perspective: 1000px;
    }
    .transform-style-3d {
      transform-style: preserve-3d;
    }
    .backface-hidden {
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }
    .is-flipped {
      transform: rotateY(180deg) !important;
    }
    .reveal-text {
      opacity: 1 !important;
      pointer-events: auto !important;
      transform: scale(1) !important;
    }
  </style>
</Layout>