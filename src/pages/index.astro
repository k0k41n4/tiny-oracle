---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import PayPalButton from '../components/PayPalButton.astro';

// Retrieve Client ID from Environment Variable
const PAYPAL_CLIENT_ID = import.meta.env.PUBLIC_PAYPAL_CLIENT_ID;
---

<Layout title="Tiny Oracle — Unveil Your Fate" description="Draw your 3-card tarot reading (Past, Present, Future) instantly!">
  <div class="w-full max-w-xl text-center space-y-8 bg-purple-950/40 p-6 md:p-10 rounded-3xl border border-purple-500/20 backdrop-blur-md shadow-[0_0_50px_rgba(18,10,42,0.8)] my-auto">
    
    <!-- Hero Section -->
    <div class="space-y-3">
      <span class="inline-block px-4 py-1.5 rounded-full bg-purple-900/50 border border-pink-300/30 text-pink-300 text-[11px] font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(244,114,182,0.2)]">
        ✦ Mystic Whimsical Experience ✦
      </span>
      <h1 class="text-3xl md:text-5xl font-black font-serif tracking-tight bg-gradient-to-r from-amber-100 via-pink-200 to-amber-300 bg-clip-text text-transparent">
        UNVEIL YOUR FATE
      </h1>
      <p class="text-purple-200/70 text-xs md:text-sm max-w-md mx-auto leading-relaxed">
        Draw your 3 Sacred Cards (Past, Present, & Future). Unlock your spiritual insights instantly.
      </p>
    </div>

    <!-- Visual Deck Card Animation Preview -->
    <div class="flex justify-center items-center -space-x-8 py-2">
      <div class="w-20 h-36 md:w-24 md:h-40 bg-[#0d0722] border-2 border-purple-500/30 rounded-xl shadow-lg -rotate-12 transform hover:rotate-0 transition duration-300 flex items-center justify-center">
        <span class="text-purple-400/40 text-lg">✦</span>
      </div>
      <div class="w-20 h-36 md:w-24 md:h-40 bg-[#0d0722] border-2 border-amber-300 rounded-xl shadow-[0_0_25px_rgba(251,191,36,0.3)] z-10 scale-105 flex items-center justify-center">
        <span class="text-amber-200 font-serif font-extrabold text-2xl">TO</span>
      </div>
      <div class="w-20 h-36 md:w-24 md:h-40 bg-[#0d0722] border-2 border-purple-500/30 rounded-xl shadow-lg rotate-12 transform hover:rotate-0 transition duration-300 flex items-center justify-center">
        <span class="text-purple-400/40 text-lg">✦</span>
      </div>
    </div>

    <!-- Pricing Box -->
    <div class="border-y border-purple-500/20 py-4 flex justify-between items-center px-4 md:px-8 bg-[#090417]/60 rounded-2xl">
      <div class="text-left">
        <h2 class="text-xs font-bold text-amber-200 uppercase tracking-wider font-serif">3-Card Tarot Reading</h2>
        <p class="text-[10px] text-purple-300/60">Past, Present, & Future Spread</p>
      </div>
      <div class="text-right">
        <span class="text-2xl font-black text-amber-300 font-serif">$5.00</span>
        <span class="text-[10px] text-purple-300/60 block">USD</span>
      </div>
    </div>

    <!-- PayPal Button Integration -->
    <div class="pt-2">
      <PayPalButton clientId={PAYPAL_CLIENT_ID} amount="5.00" />
    </div>

  </div>
</Layout>