---
// src/pages/reading.astro
import Layout from "../layouts/Layout.astro";
import tarotData from "../assets/tarot-images.json";

// Murni cuma ambil data JSON tarot aja di frontmatter
const allCards = tarotData.cards;
---

<Layout title="Your Tarot Reading — Tiny Oracle">
  <script
    is:inline
    src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"
  ></script>

  <div class="w-full max-w-4xl mx-auto space-y-16 py-8 px-4">
    <!-- Hero Header -->
    <div class="text-center space-y-4 max-w-xl mx-auto">
      <span
        class="inline-block px-4 py-1.5 rounded-full bg-purple-900/50 border border-pink-300/30 text-pink-300 text-xs font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(244,114,182,0.2)]"
      >
        ✦ The Tale of Three Cards ✦
      </span>
      <h1
        class="text-3xl md:text-5xl font-black font-serif text-transparent bg-gradient-to-r from-amber-100 via-pink-200 to-amber-300 bg-clip-text"
      >
        YOUR SACRED ORACLE
      </h1>
      <p
        class="text-purple-200/70 text-xs md:text-sm font-medium leading-relaxed"
      >
        Unfold the chapters of your destiny. Click each card to reveal the
        hidden wisdom within.
      </p>
    </div>

    <!-- Container Kartu Dinamis -->
    <div id="reading-container" class="space-y-16 min-h-[400px]">
      <!-- Content cards render here via JS -->
    </div>

    <!-- Call To Action Bottom -->
    <div class="pt-12 text-center space-y-4 border-t border-purple-500/20">
      <button
        onclick="window.location.reload()"
        class="inline-block px-10 py-4 rounded-2xl bg-gradient-to-r from-amber-300 via-pink-300 to-amber-400 text-slate-950 font-serif font-black text-sm hover:scale-105 active:scale-95 transition shadow-[0_0_30px_rgba(251,191,36,0.4)] cursor-pointer"
      >
        DRAW ANOTHER SPREAD ($5)
      </button>
      <p class="text-[11px] text-purple-300/50">
        Destiny is ever-shifting. Every new draw channels fresh cosmic energy.
      </p>
    </div>
  </div>

  <!-- Client-side script murni -->
  <script is:inline define:vars={{ allCards }}>
    // Fisher-Yates Shuffle
    function shuffleDeck(deck) {
      const array = [...deck];
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    }

    // Acak 3 kartu tiap kali refresh/buka
    const shuffled = shuffleDeck(allCards);
    const selectedCards = shuffled.slice(0, 3).map((card) => {
      const isReversed = Math.random() < 0.3;
      // Ambil nama file tanpa ekstensi
      const name_short = card.img.replace(/\.(jpg|png|webp)$/, "");
      const meaningList = isReversed
        ? card.meanings.shadow
        : card.meanings.light;
      return {
        name: card.name,
        name_short: name_short,
        meaning: meaningList.join(". "),
        isReversed: isReversed,
      };
    });

    const sectionMeta = [
      {
        chapter: "CHAPTER I",
        label: "The Past",
        storyContext:
          "Echoes of your footsteps and foundational energies that shaped your journey to this moment.",
        reverseLayout: false,
      },
      {
        chapter: "CHAPTER II",
        label: "The Present",
        storyContext:
          "A mirror to your current reality. The active forces unfolding around your mind and soul.",
        reverseLayout: true,
      },
      {
        chapter: "CHAPTER III",
        label: "The Future",
        storyContext:
          "Whispers of fate and potential events gently weaving into your upcoming timeline.",
        reverseLayout: false,
      },
    ];

    const container = document.getElementById("reading-container");
    if (container) {
      container.innerHTML = selectedCards
        .map((card, index) => {
          const meta = sectionMeta[index];
          // LANGSUNG TEMBAK KE FOLDER /public/cards/*.webp !
          const imagePath = `/cards/${card.name_short}.webp`;

          return `
          <section class="w-full bg-purple-950/30 border border-purple-500/20 rounded-3xl p-6 md:p-10 backdrop-blur-md shadow-[0_0_40px_rgba(18,10,42,0.8)] relative overflow-hidden group">
            
            <div class="flex items-center justify-between border-b border-purple-500/20 pb-4 mb-6">
              <div class="space-y-0.5">
                <span class="text-[10px] font-mono font-bold tracking-widest text-amber-300/80 uppercase block">${meta.chapter}</span>
                <h2 class="text-lg md:text-xl font-serif font-bold text-pink-200">${meta.label}</h2>
              </div>
              <span class="text-[11px] font-mono font-bold text-amber-200 bg-amber-400/10 px-3 py-1 rounded-full border border-amber-300/30">
                ${card.isReversed ? "↺ REVERSED" : "🡅 UPRIGHT"}
              </span>
            </div>

            <div class="flex flex-col ${meta.reverseLayout ? "md:flex-row-reverse" : "md:flex-row"} items-center md:items-start gap-8 md:gap-12">
              
              <!-- Card Wrapper -->
              <div class="card-wrapper perspective-1000 w-52 h-84 md:w-60 md:h-96 flex-shrink-0 cursor-pointer" onclick="flipTarotCard(this)">
                <div class="card-inner relative w-full h-full transition-transform duration-700 transform-style-3d shadow-2xl rounded-2xl">
                  
                  <!-- Card Back -->
                  <div class="absolute inset-0 w-full h-full bg-[#0d0722] border-2 border-amber-300/40 rounded-2xl shadow-[0_0_20px_rgba(244,114,182,0.15)] flex flex-col items-center justify-center backface-hidden hover:border-pink-300 hover:shadow-[0_0_30px_rgba(244,114,182,0.3)] transition-all">
                    <div class="w-[90%] h-[93%] border border-purple-400/20 rounded-xl flex items-center justify-center bg-gradient-to-b from-purple-900/30 to-purple-950/80">
                      <div class="text-center space-y-2">
                        <span class="text-4xl block animate-pulse">✦</span>
                        <span class="text-amber-200 font-serif text-xl tracking-widest block font-bold">ORACLE</span>
                        <p class="text-[10px] text-pink-300/70 tracking-widest uppercase">Click to Reveal</p>
                      </div>
                    </div>
                  </div>

                  <!-- Card Front (WebP Image) -->
                  <div class="absolute inset-0 w-full h-full bg-slate-950 border-2 border-amber-300 rounded-2xl shadow-[0_0_35px_rgba(251,191,36,0.3)] rotate-y-180 backface-hidden p-2 flex flex-col items-center justify-center">
                    <div class="w-full h-full overflow-hidden rounded-xl bg-purple-950 flex items-center justify-center ${card.isReversed ? "rotate-180" : ""}">
                      <!-- KODE BARU (GAMBAR UTUH, RAPI, GAK NGE-ZOOM) -->
                      <img src="${imagePath}" alt="${card.name}" class="w-full h-full object-contain p-1 rounded-lg drop-shadow-md" onerror="this.src='/cards/card-back.jpg'" />
                    </div>
                  </div>

                </div>
              </div>

              <!-- Reading Text -->
              <div class="card-reading-text flex-grow space-y-4 text-left opacity-0 pointer-events-none scale-95 transition-all duration-700 ease-out">
                <div>
                  <span class="text-xs font-serif text-purple-300/60 italic block mb-1">"${meta.storyContext}"</span>
                  <h3 class="text-2xl md:text-3xl font-serif font-black bg-gradient-to-r from-amber-100 via-pink-200 to-amber-200 bg-clip-text text-transparent">${card.name}</h3>
                </div>

                <div class="bg-[#090417]/80 border border-purple-500/20 p-5 rounded-2xl space-y-2 shadow-inner">
                  <span class="text-xs font-bold uppercase tracking-wider text-amber-300/90 flex items-center gap-1.5">
                    <span>✨</span> Interpretation & Guidance:
                  </span>
                  <p class="text-sm md:text-base leading-relaxed text-purple-100/90 font-medium">${card.meaning}</p>
                </div>
              </div>

            </div>
          </section>
        `;
        })
        .join("");
    }

    // Handler Flip Global
    window.flipTarotCard = function (element) {
      const inner = element.querySelector(".card-inner");
      const section = element.closest("section");
      const readingText = section
        ? section.querySelector(".card-reading-text")
        : null;

      if (inner && !inner.classList.contains("is-flipped")) {
        inner.classList.add("is-flipped");
        if (readingText) readingText.classList.add("reveal-text");
        if (typeof confetti === "function") {
          confetti({
            particleCount: 45,
            spread: 70,
            origin: { y: 0.6 },
            colors: ["#fef3c7", "#f472b6", "#c084fc"],
          });
        }
      }
    };
  </script>

  <style is:global>
    .perspective-1000 {
      perspective: 1000px;
    }
    .transform-style-3d {
      transform-style: preserve-3d;
    }
    .backface-hidden {
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
    }
    .rotate-y-180 {
      transform: rotateY(180deg);
    }
    .is-flipped {
      transform: rotateY(180deg) !important;
    }
    .reveal-text {
      opacity: 1 !important;
      pointer-events: auto !important;
      transform: scale(1) !important;
    }
  </style>
</Layout>
