---
// src/components/PayPalButton.astro
interface Props {
  clientId: string;
  amount?: string;
}

const { clientId, amount = '5.00' } = Astro.props;
---

<div class="w-full max-w-sm mx-auto space-y-3">
  <!-- PayPal button container -->
  <div id="paypal-button-container" class="min-h-[150px] flex items-center justify-center">
    <div id="paypal-loading" class="text-amber-300 text-xs font-mono animate-pulse">
      Loading PayPal...
    </div>
  </div>
  <p class="text-[11px] text-purple-300/60 text-center">
    Payments are securely processed via PayPal
  </p>
</div>

<!-- Load PayPal SDK -->
<script is:inline src={`https://www.paypal.com/sdk/js?client-id=${clientId}&currency=USD`}></script>

<script is:inline define:vars={{ amount }}>
  // Ensure PayPal SDK is loaded
  if (window.paypal) {
    const loadingEl = document.getElementById('paypal-loading');
    if (loadingEl) loadingEl.style.display = 'none';

    window.paypal.Buttons({
      style: {
        layout: 'vertical',
        color: 'gold',
        shape: 'rect',
        label: 'pay'
      },

      // 1. Create a $5 transaction order
      createOrder: function(data, actions) {
        return actions.order.create({
          purchase_units: [{
            description: 'Tiny Oracle - 3 Card Tarot Reading',
            amount: {
              value: amount
            }
          }]
        });
      },

      // 2. On payment success
      onApprove: function(data, actions) {
        return actions.order.capture().then(function(details) {
          // Generate a simple unique token for the reading session
          const sessionToken = btoa(Date.now() + '_' + details.id);
          
          // Redirect to the reading page
          window.location.href = `/reading?paid=true&order_id=${details.id}&session=${sessionToken}`;
        });
      },

      // 3. On payment error
      onError: function(err) {
        console.error('PayPal Error:', err);
        alert('An error occurred while processing your payment. Please try again.');
      }
    }).render('#paypal-button-container');
  }
</script>